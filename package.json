{
  "name": "planner",
  "version": "0.0.2",
  "private": true,
  "description": "Planner: an open-source personal planner with time blocks, a board, habit and time trackers, Supabase sync and optional Claude day planning.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "npm install && node scripts/local-browsers.mjs npx playwright install chromium",
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "node scripts/local-browsers.mjs npx playwright test",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.8.0",
    "@fontsource/roboto": "^5.2.0",
    "@material-symbols/svg-400": "^0.31.0",
    "@supabase/supabase-js": "^2.50.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
