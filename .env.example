# Copy this file to .env and fill in your own Supabase project's values.
# Project Settings -> API Keys in the Supabase dashboard.
# The publishable key is safe in the browser because every table uses row-level security.
# Never put a secret key (sb_secret_...) or the service_role key here or anywhere in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
